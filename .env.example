# Secrets only — copy to .env and fill in. NEVER commit .env.
# LLM calls go through OpenRouter (OpenAI-compatible API); one key per component.
OR_NewsFilterAPI=your_openrouter_key_for_the_news_filter
FINVIZ_AUTH_TOKEN=your_finviz_elite_auth_token
DISCORD_NEWS_WEBHOOK_URL=your_discord_news_webhook_url
DISCORD_URGENT_WEBHOOK_URL=your_discord_urgent_webhook_url
DEDUPE_PATH=./seen.db          # local dev; on Render: /var/data/seen.db

# Optional overrides:
# FINVIZ_NEWS_EXPORT_URL=https://elite.finviz.com/news_export.ashx
# LOG_LEVEL=INFO

# cadbury_bot (end-of-day recap email) — only needed if config.yaml has an
# enabled `cadbury_bot:` block. GMAIL_APP_PASSWORD is a Google App Password
# (account needs 2FA): https://myaccount.google.com/apppasswords
OR_CadburySummaryAPI=your_openrouter_key_for_the_recap
GMAIL_ADDRESS=your_gmail_address@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
